# Build Mac for the scripts (copy to scripts/mac.env, which is git-ignored, and fill in).
MAC=${MAC:-you@your-mac.local}            # SSH target with Xcode, xcodegen (and idb for shot/tap)
# MAC_DIR=video-player                     # the copy of the repository there, relative to its home
#                                          (default video-player; on a Mac itself, MAC=local, the checkout)
SIM_PHONE=                                 # simulator UDIDs on that Mac (xcrun simctl list devices)
SIM_TV=
PHONE_DEVICE=                              # paired devices (xcrun devicectl list devices)
IPAD_DEVICE=
TV_DEVICE=
MAC_PATH='export PATH=$HOME/bin:/usr/local/bin:/opt/homebrew/bin:$PATH'
# Unlock the login keychain for signing over SSH (the password in ~/.build-keychain-pw, chmod 600).
MAC_UNLOCK='security unlock-keychain -p "$(cat ~/.build-keychain-pw)" ~/Library/Keychains/login.keychain-db >/dev/null 2>&1'
# App Store Connect API key on the Mac (signing with -allowProvisioningUpdates, TestFlight): a file
# that exports ASC_KEY_ID, ASC_ISSUER_ID and APPLE_TEAM_ID, and the .p8 key. Paths on the Mac.
# Only signed builds use these and MAC_UNLOCK: simulator builds need none of them.
ASC_ENV='~/.asc.env'
ASC_KEY_PATH='~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8'
# The App Review contact for scripts/release-apple.sh metadata / review: a file on the Mac exporting
# MOONRISE_REVIEW_FIRST_NAME, MOONRISE_REVIEW_LAST_NAME, MOONRISE_REVIEW_PHONE, MOONRISE_REVIEW_EMAIL.
REVIEW_ENV=
# Where release-apple.sh builds on the Mac, relative to its home (its own copy; default moonrise-release).
# RELEASE_DIR=moonrise-release
# Mac with fastlane (ota.sh, release-apple.sh) and for scripts/build-tailscalekit.sh (needs Go).
FASTLANE_MAC=$MAC
TSKIT_MAC=$MAC
# sim.sh/tvsim.sh: the Moonrise server the simulator signs in to (credentials: MOONRISE_CREDS_FILE, or an
# executable scripts/local/creds.sh that prints user name and password for `creds.sh moonrise`).
MOONRISE_SERVER_URL=http://localhost:8097
# Screenshots from shot.sh/tvshot.sh land here.
SHOT_DIR=${SHOT_DIR:-/tmp/moonrise-shots}
# Connecting to the Mac: attempts (an SSH handshake that times out is tried again), seconds each.
MAC_SSH_TRIES=3
MAC_SSH_TIMEOUT=10
