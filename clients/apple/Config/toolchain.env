# The Apple toolchain the apps are built and tested with. scripts/xcodegen.sh (run by build.sh,
# test-apple.sh, ota.sh and testflight.sh on the Mac) compares the Mac's versions with these: a
# different version only prints a warning, an older Xcode major than this one stops the build (the
# apps need the 26 SDKs). Bump these when the build Mac moves on and scripts/test-all.sh apple passes.
# Xcode 27.x (on one build Mac since 2026-11) warns and builds; the test simulator is picked from
# whatever runtimes the Mac's Xcode has (scripts/sim-new.sh), so tests don't depend on this version.
XCODE_VERSION=26.3
XCODEGEN_VERSION=2.45.4
